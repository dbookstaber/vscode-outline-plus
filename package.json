{
  "private": true,
  "author": {
    "name": "David Bookstaber",
    "email": "bookstaber@gmail.com"
  },
  "publisher": "DavidBookstaber",
  "name": "outline-regions-plus",
  "displayName": "Outline++ (Regions & Colors)",
  "description": "Outline++: navigate code regions and document outlines with color-coded modifier icons.",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbookstaber/vscode-outline-plus.git"
  },
  "homepage": "https://github.com/dbookstaber/vscode-outline-plus#readme",
  "bugs": {
    "url": "https://github.com/dbookstaber/vscode-outline-plus/issues"
  },
  "galleryBanner": {
    "color": "#00002e",
    "theme": "dark"
  },
  "icon": "assets/icon.png",
  "license": "GPL-3.0-only",
  "version": "1.2.0",
  "engines": {
    "vscode": "^1.94.0"
  },
  "categories": [
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "outline++",
    "outline-plus",
    "outline",
    "regions",
    "region",
    "symbols",
    "document-symbols",
    "navigation",
    "code-navigation",
    "tree-view",
    "code-structure"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "virtualWorkspaces": true,
    "untrustedWorkspaces": {
      "supported": "limited",
      "restrictedConfigurations": [
        "outlinePlus.regionBoundaryPatternByLanguageId"
      ]
    }
  },
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "outlinePlus.goToRegionBoundary",
        "title": "Go to Region Boundary",
        "category": "Outline++"
      },
      {
        "command": "outlinePlus.selectCurrentRegion",
        "title": "Select Current Region",
        "category": "Outline++"
      },
      {
        "command": "outlinePlus.goToRegionFromQuickPick",
        "title": "Go to Region...",
        "category": "Outline++"
      },
      {
        "command": "outlinePlus.goToNextRegion",
        "title": "Go to Next Region",
        "category": "Outline++"
      },
      {
        "command": "outlinePlus.goToPreviousRegion",
        "title": "Go to Previous Region",
        "category": "Outline++"
      },
      {
        "command": "outlinePlus.regionsView.stopAutoHighlightingActiveRegion",
        "title": "Regions View: Stop Auto-Highlighting Active Region",
        "category": "Outline++",
        "icon": "$(sync)"
      },
      {
        "command": "outlinePlus.regionsView.startAutoHighlightingActiveRegion",
        "title": "Regions View: Start Auto-Highlighting Active Region",
        "category": "Outline++",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "outlinePlus.fullOutlineView.stopAutoHighlightingActiveItem",
        "title": "Full Outline View: Stop Auto-Highlighting Active Item",
        "category": "Outline++",
        "icon": "$(sync)"
      },
      {
        "command": "outlinePlus.fullOutlineView.startAutoHighlightingActiveItem",
        "title": "Full Outline View: Start Auto-Highlighting Active Item",
        "category": "Outline++",
        "icon": "$(sync-ignored)"
      },
      {
        "command": "outlinePlus.regionsView.expandAll",
        "title": "Regions View: Expand All",
        "category": "Outline++",
        "icon": "$(expand-all)"
      },
      {
        "command": "outlinePlus.fullOutlineView.expandAll",
        "title": "Full Outline View: Expand All",
        "category": "Outline++",
        "icon": "$(expand-all)"
      },
      {
        "command": "outlinePlus.regionsView.refresh",
        "title": "Regions View: Refresh",
        "category": "Outline++",
        "icon": "$(refresh)"
      },
      {
        "command": "outlinePlus.fullOutlineView.refresh",
        "title": "Full Outline View: Refresh",
        "category": "Outline++",
        "icon": "$(refresh)"
      },
      {
        "command": "outlinePlus.showDebugLog",
        "title": "Show Debug Log",
        "category": "Outline++"
      },
      {
        "command": "outlinePlus.dumpDiagnosticState",
        "title": "Dump Diagnostic State",
        "category": "Outline++"
      }
    ],
    "configuration": [
      {
        "title": "Outline++",
        "order": 0,
        "properties": {
          "outlinePlus.regionBoundaryPatternByLanguageId": {
            "type": "object",
            "description": "Regular expression strings to match region boundaries for different languages.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "startRegex": {
                  "description": "JS-format regular expression string (or array of regex strings) to match the start of a region. Should ideally include a capturing group for the region name.",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "endRegex": {
                  "description": "JS-format regular expression string (or array of regex strings) to match the end of a region.",
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  ]
                }
              },
              "required": [
                "startRegex",
                "endRegex"
              ]
            },
            "default": {
              "c": {
                "startRegex": "^\\s*\\/\\/\\s*#region(?:\\s+(.*?)\\s*)?$",
                "endRegex": "^\\s*\\/\\/\\s*#endregion(?:\\s.*)?$"
              },
              "clojure": {
                "startRegex": "^\\s*;+\\s*#region(?:\\s+(.*?)\\s*)?$",
                "endRegex": "^\\s*;+\\s*#endregion(?:\\s.*)?$"
